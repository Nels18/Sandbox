    "@capacitor/cli": "latest",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^29.5.13",
    "@typescript-eslint/eslint-plugin": "7.11.0",
    "@typescript-eslint/parser": "7.11.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
